{
  "name": "Discord-Netflix-Revived",
  "version": "1.3.1",
  "description": "Revived desktop Netflix client with resilient Discord Rich Presence, sandbox fixes, and Widevine playback",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "macbuild": "electron-builder -m",
    "linbuild": "electron-builder -l",
    "winbuild": "electron-builder --win --x64",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/djell1l/Discord-Netflix-Revived.git"
  },
  "author": "djell1l",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/djell1l/Discord-Netflix-Revived/issues"
  },
  "build": {
    "appId": "DiscordNetflixRevived",
    "productName": "Discord-Netflix-Revived",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "./assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "./assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "./assets/icon.png"
    },
    "artifactName": "${productName}_Setup_${version}.${ext}",
    "electronVersion": "37.10.3+wvcus",
    "electronDownload": {
      "version": "37.10.3+wvcus",
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    }
  },
  "homepage": "https://github.com/djell1l/Discord-Netflix-Revived#readme",
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.0",
    "axios": "^1.15.2",
    "electron-discord-register": "1.0.0",
    "jquery": "^3.7.1",
    "moment": "2.30.1",
    "node-fetch": "^3.3.2",
    "setimmediate": "^1.0.5",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "all-contributors-cli": "^6.26.1",
    "electron-builder": "^26.7.0"
  }
}
